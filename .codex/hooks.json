{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/scripts/chat-agent-advisor-hook.sh SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/scripts/chat-agent-advisor-hook.sh UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/scripts/chat-agent-advisor-hook.sh Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
