# Normalize line endings to LF on commit
* text=auto eol=lf

# Text files
*.md        text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
Makefile    text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.sqlite    binary
