#!/bin/sh
# Thin wrapper around the active-pipeline orchestrator. Runs every
# active runner against one or all programs in a single command,
# honoring RECON_ENABLED + per-program FROZEN flags.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ -f "$ROOT/.env" ]; then
  # shellcheck disable=SC1091
  . "$ROOT/.env"
fi

if [ ! -x "$ROOT/.venv/bin/python" ]; then
  echo "active-tick: .venv not found at $ROOT/.venv — run 'make install-dev' first" >&2
  exit 1
fi

exec "$ROOT/.venv/bin/python" -m earn_money.engine.active_tick_cli --root "$ROOT" "$@"
