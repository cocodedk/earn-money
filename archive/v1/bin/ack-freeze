#!/bin/sh
# Audited freeze-flag removal — the operator's explicit action to resume
# recon for a program after a destructive scope diff was caught.
set -eu

ROOT="${ACK_FREEZE_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

if [ $# -ne 1 ]; then
    echo "usage: bin/ack-freeze <platform>/<slug>" >&2
    exit 1
fi

PROGRAM="$1"

# Validate platform/slug shape and reject path-traversal
case "$PROGRAM" in
    *..*|/*|*//*|*\\*)
        echo "ack-freeze: invalid program path: $PROGRAM" >&2; exit 1 ;;
    */*) ;;
    *) echo "ack-freeze: argument must be <platform>/<slug>, got: $PROGRAM" >&2; exit 1 ;;
esac

PLATFORM="${PROGRAM%%/*}"
SLUG="${PROGRAM##*/}"
FROZEN="$ROOT/programs/$PLATFORM/$SLUG/FROZEN"
LOG="$ROOT/programs/$PLATFORM/$SLUG/freeze-acks.log"

# Check program is registered
SCOPE="$ROOT/programs/$PLATFORM/$SLUG/scope.md"
if [ ! -f "$SCOPE" ]; then
    echo "ack-freeze: program $PROGRAM is not registered (no $SCOPE)" >&2
    exit 1
fi

if [ ! -f "$FROZEN" ]; then
    echo "ack-freeze: no FROZEN flag at $FROZEN" >&2
    exit 1
fi

# Snapshot FROZEN once — defends against the file changing between display
# and audit-log append.
FROZEN_CONTENT="$(cat "$FROZEN")"

echo "--- FROZEN contents ---"
printf '%s\n' "$FROZEN_CONTENT"
echo "---"

# Allow multi-line reason via $EDITOR (mirror git's commit-message UX)
REASON_FILE=$(mktemp -t ack-freeze-reason.XXXXXX)
trap 'rm -f "$REASON_FILE"' EXIT
cat > "$REASON_FILE" <<EOF
# Reason for resuming recon (lines starting with # are ignored).
# This message will be appended to programs/$PROGRAM/freeze-acks.log.
# Save and quit to ack; quit without saving to abort.
EOF
"${EDITOR:-${VISUAL:-vi}}" "$REASON_FILE"
REASON=$(grep -vE "^[[:space:]]*#" "$REASON_FILE" | sed -e 's/^[[:space:]]*//' | grep -v "^$" || true)
[ -z "$REASON" ] && { echo "ack-freeze: empty reason refused" >&2; exit 1; }

NOW=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
{
    echo "## $NOW"
    echo "operator: $(whoami)"
    echo "reason: $REASON"
    echo "frozen-content-was:"
    printf '%s\n' "$FROZEN_CONTENT" | sed 's/^/  /'
    echo
} >> "$LOG"

rm "$FROZEN"
echo "ack-freeze: $PROGRAM resumed at $NOW (audit appended to $LOG)"
