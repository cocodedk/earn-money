#!/bin/sh
# Bootstrap + full pipeline run against target.cocode.dk (Juice Shop).
# Usage: bin/juice-shop-run [--platform local] [--program juice-shop]
#        [--base-url https://target.cocode.dk] [--root /path/to/repo]
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ -f "$ROOT/.env" ]; then
  # shellcheck disable=SC1091
  . "$ROOT/.env"
fi

if [ ! -x "$ROOT/.venv/bin/python" ]; then
  echo "juice-shop-run: .venv not found at $ROOT/.venv — run 'make install-dev' first" >&2
  exit 1
fi

exec "$ROOT/.venv/bin/python" -m earn_money.runners.juice_shop_run_cli --root "$ROOT" "$@"
