# Example environment variables for earn-money.
# Copy to .env and fill in real values; never commit .env (gitignored).

# ── OpenRouter task-router model selection ─────────────────────────────
#
# Each TaskType maps to an env var here; `task_router.resolve_model()`
# checks the per-task var first, then falls back to OPENROUTER_DEFAULT_MODEL.
# All values below are exact OpenRouter model IDs (curl https://openrouter.ai/api/v1/models).
#
# Default profile picks (2026-05-17):
# - Mistral Small 2603 → planning / extraction / report drafting / default.
#   Newest in the Mistral Small line; structured-output + tool-use capable,
#   128K context, cheap. Reviewer's preferred scanner-side default; we use
#   the 2603 date-coded variant (newer than 3.2-24b-instruct).
# - DeepSeek v4-pro → deep reasoning + coding-security analysis.
#   Newest in the DeepSeek v4 line; strong agentic + reasoning behavior,
#   acceptable cost.
#
# If a model later misbehaves on `response_format=json_object`, add its
# exact ID to LLM_DISABLE_RESPONSE_FORMAT_MODELS (see bottom).
OPENROUTER_MODEL_AGENT_PLANNING=mistralai/mistral-small-2603
OPENROUTER_MODEL_STRUCTURED_EXTRACTION=mistralai/mistral-small-2603
OPENROUTER_MODEL_REPORT_WRITING=mistralai/mistral-small-2603
OPENROUTER_MODEL_DEFAULT_ASSISTANT=mistralai/mistral-small-2603
OPENROUTER_MODEL_DEEP_REASONING=deepseek/deepseek-v4-pro
OPENROUTER_MODEL_CODING_SECURITY=deepseek/deepseek-v4-pro

# Fallback used when no task-specific var is set.
OPENROUTER_DEFAULT_MODEL=mistralai/mistral-small-2603

# ── response_format compatibility list ─────────────────────────────────
#
# Some OpenRouter model adapters produce less reliable JSON when
# response_format=json_object is sent. Listed exact model IDs skip the
# kwarg and rely on prompt + application-side validation. Exact-match
# only; add suffix variants (`:free`) explicitly if needed.
LLM_DISABLE_RESPONSE_FORMAT_MODELS=qwen/qwen3-235b-a22b
