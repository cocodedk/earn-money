# --- Operational secrets and state — NEVER commit ---
# Identity, payouts, KYC, VPS details
identity/platforms.md

# Local kill-switch — must be set per-clone, never tracked
RECON_ENABLED

# Per-program state databases
programs/**/db.sqlite
programs/**/db.sqlite-*
*.sqlite
*.db

# Raw recon artifacts — may contain target PII, tokens, response bodies
recon/outputs/

# Local environment overrides
.env
.env.*
.envrc

# Claude Code / MCP — per-session config containing absolute paths and
# operator-specific hook scripts; never commit.
.claude/
.mcp.json

# --- OS, editor, language artifacts ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node (in case we add tooling later)
node_modules/

# Logs — but freeze-acks.log is an audit trail and must be committable
*.log
!programs/**/freeze-acks.log

# Drafts contain real evidence pointers (target URLs, asset names, paths
# into recon/outputs/). Never commit. Operator's edited drafts stay
# local; submitted reports live on the platform, not in this repo.
reports/drafts/

# Local scratch
scratch/
tmp/

# Browser automation artifacts (playwright-mcp, screenshots)
.playwright-mcp/
deluxe_page*.png

# Build artefacts
build/
dist/
*.egg-info/
.venv/
demo_coderabbit.py
