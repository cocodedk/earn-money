[Unit]
# Docker Compose stack for the earn-money platform. Nginx exposes the
# React dashboard and Django API on host port 80; Caddy may terminate TLS
# in front of it.
Description=earn-money Docker Compose stack
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/earn-money
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose stop
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=true
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
