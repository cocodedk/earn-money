[Unit]
# Live read-only dashboard for the earn-money pipeline.
# Bind: 0.0.0.0:80 (direct access). The HOST firewall must be the auth
# boundary — restrict inbound 80/tcp to the operator's IP. The service
# itself has no auth; if the FW rule is wide-open you've leaked recon
# state on plaintext HTTP.
Description=earn-money dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/earn-money
ExecStart=/opt/earn-money/bin/dashboard --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=5
User=root
# Defense in depth: filesystem hardening even though the service is
# read-only by design (sqlite3 ?mode=ro URI).
ProtectSystem=strict
ReadOnlyPaths=/opt/earn-money
ReadWritePaths=/opt/earn-money/recon/outputs
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
